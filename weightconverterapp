package com.example.weightconverterapp;

import android.os.Bundle;
import android.view.View;
import android.widget.*;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    // UI Components
    // Input and output text fields
    EditText editTextInput, editTextResult;

    // Menus (spinners) for selecting units
    Spinner spinnerTo, spinnerFrom;

    // Buttons for conversion, clearing, and swapping units
    Button btnConvert, btnClear, btnSwap;

    // List of available weight units
    String[] units = {"Kilogram (kg)", "Gram (g)", "Pound (lbs)", "Stone", "Ounce (oz)", "Tonne (t)"};

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main); // Link to the XML layout

        // Connects UI Elements to ID
        editTextInput = findViewById(R.id.editTextInput);
        editTextResult = findViewById(R.id.editTextResult);
        spinnerFrom = findViewById(R.id.spinnerFrom);
        spinnerTo = findViewById(R.id.spinnerTo);
        btnConvert = findViewById(R.id.btnConvert);
        btnClear = findViewById(R.id.btnClear);
        btnSwap = findViewById(R.id.btnSwap);

        // Set Up of Menus (Spinners)
        // Create an adapter to show unit names in both spinners
        ArrayAdapter<String> adapter = new ArrayAdapter<>(this,
                android.R.layout.simple_spinner_item, units);
        adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item);

        spinnerFrom.setAdapter(adapter);
        spinnerTo.setAdapter(adapter);

        // Sets default conversion: from kilograms to grams
        spinnerFrom.setSelection(0); // "Kilogram (kg)"
        spinnerTo.setSelection(1);   // "Gram (g)"

        // Button Click Listener
        // Convert button for the weight conversion
        btnConvert.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                convertWeight();
            }
        });

        // Clear button resets input, output, and unit selections
        btnClear.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                clearFields();
            }
        });

        // Swap button switches the "from" and "to" units
        btnSwap.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                swapUnits();
            }
        });
    }

    // Conversion
    // Handles validation, conversion calculations, and displaying result
    private void convertWeight() {
        String inputText = editTextInput.getText().toString();

        // Checks if the input field is empty or filled
        if (inputText.isEmpty()) {
            Toast.makeText(this, "Enter a value to convert", Toast.LENGTH_SHORT).show();
            return;
        }

        // Gets the input value and the selected units
        double value = Double.parseDouble(inputText);
        String fromUnit = spinnerFrom.getSelectedItem().toString();
        String toUnit = spinnerTo.getSelectedItem().toString();

        // Converts to kilograms, then from kilograms, to the target unit
        double valueInKg = convertToKilograms(value, fromUnit);
        double result = convertFromKilograms(valueInKg, toUnit);

        // Display the result formatted to 5 decimal places
        editTextResult.setText(String.format("%.5f", result));
    }

    // Help Method: Converts units into Kilograms
    // Converts any unit into its equivalent value in kilograms
    private double convertToKilograms(double value, String unit) {
        switch (unit) {
            case "Kilogram (kg)": return value;
            case "Gram (g)": return value / 1000;
            case "Pound (lbs)": return value * 0.453592;
            case "Stone": return value * 6.35029;
            case "Ounce (oz)": return value * 0.0283495;
            case "Tonne (t)": return value * 1000;
            default: return value;
        }
    }

    // ===== Helper Method: Convert from Kilograms =====
    // Converts kilograms into the selected target unit
    private double convertFromKilograms(double valueInKg, String unit) {
        switch (unit) {
            case "Kilogram (kg)": return valueInKg;
            case "Gram (g)": return valueInKg * 1000;
            case "Pound (lbs)": return valueInKg * 2.20462;
            case "Stone": return valueInKg / 6.35029;
            case "Ounce (oz)": return valueInKg / 0.0283495;
            case "Tonne (t)": return valueInKg / 1000;
            default: return valueInKg;
        }
    }

    // Clear Button
    // Resets text fields and spinners to default values
    private void clearFields() {
        editTextInput.setText("");
        editTextResult.setText("");
        spinnerFrom.setSelection(0);
        spinnerTo.setSelection(1);
    }

    // Swap Button
    // Switches the "from" and "to" unit selections
    private void swapUnits() {
        int fromPos = spinnerFrom.getSelectedItemPosition();
        int toPos = spinnerTo.getSelectedItemPosition();
        spinnerFrom.setSelection(toPos);
        spinnerTo.setSelection(fromPos);
    }
}
